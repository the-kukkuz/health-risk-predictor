# Copy to .env and adjust as needed. `docker compose up` reads these values.

# PostgreSQL
POSTGRES_USER=riskapp
POSTGRES_PASSWORD=riskapp
POSTGRES_DB=healthrisk
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
ENVIRONMENT=development
# Comma-separated allowed origins. The nginx-served frontend origin is 8080.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Frontend
FRONTEND_PORT=8080

# Supabase Auth
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# RAG / AI
GEMINI_API_KEY=""
QDRANT_URL=""
QDRANT_API_KEY=""
